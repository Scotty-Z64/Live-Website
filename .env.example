# ─── TenderSync SA environment ─────────────────────────────────────────────
# Copy to .env and fill in. Validate everything with: python scripts/preflight_check.py

# Runtime mode: "production" makes every external integration mandatory.
# "development" allows local fallbacks (local storage, local KMS key, text-layer OCR,
# hashed embeddings) so the stack runs without cloud credentials.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL 16 + pgvector. The app MUST connect as a NON-superuser role,
# otherwise PostgreSQL bypasses Row-Level Security.
DATABASE_URL=postgresql+psycopg://tendersync_app:tendersync_app@localhost:5432/tendersync

# Redis 7 — Celery broker/result backend, beat schedules and WebSocket pub/sub.
REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline in the API process (dev/tests only).
CELERY_EAGER=false

# AWS S3 (Cape Town). STORAGE_BACKEND=s3 in production; "local" writes to ./var/storage.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tendersync-sa-vault
AWS_REGION=af-south-1
# KMS key (af-south-1) used for SSE-KMS on S3 objects and envelope encryption of PII.
AWS_KMS_KEY_ID=

# Development-only envelope master key (base64 32 bytes) used when AWS_KMS_KEY_ID is empty.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LOCAL_MASTER_KEY=
# HMAC key for deterministic PII lookup hashes (sa_id_hash). Base64 32 bytes.
PII_HASH_KEY=
# JWT signing secret for API sessions.
JWT_SECRET=change-me

# Azure AI Document Intelligence (prebuilt-layout / prebuilt-read)
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
OCR_CONFIDENCE_THRESHOLD=0.85

# LLM & embeddings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ClamAV daemon (clamd INSTREAM protocol)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Playwright browser runner
PLAYWRIGHT_HEADLESS=true
# Seconds the Mode A worker waits for a human OTP/2FA before giving up.
SUBMISSION_OTP_TIMEOUT_S=900
